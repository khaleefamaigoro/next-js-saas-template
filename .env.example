NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/hr_pal
APP_DOMAIN=localhost:3000
SESSION_SECRET=replace-with-at-least-16-chars
OTP_PEPPER=replace-with-at-least-8-chars
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-now-12
CRON_SECRET=replace-with-at-least-16-chars

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=user
SMTP_PASS=pass
SMTP_FROM=noreply@example.com
SMTP_SECURE=false

# Optional rate limiting (fails open when unset)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_ENABLED=true

# Optional S3 / MinIO for tenant branding
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_BASE_URL=
# S3_FORCE_PATH_STYLE=true

# Optional Paystack (tenant billing later; webhook verifies signature)
# PAYSTACK_SECRET_KEY=

# Optional
# RESEND_API_KEY=
# DEFAULT_LOCALE=en
# SUPPORTED_LOCALES=en
